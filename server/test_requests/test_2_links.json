{
    "start_url": "https://books.toscrape.com/catalogue/page-4.html",
    "crawler_settings": {
        "request_delay": 2,
        "allowed_domains": ["books.toscrape.com"],
        "pagination": {
            "enabled": true,
            "next_page_selector": {
                "path": "//li[@class='next']/a",
                "selector_type": "xpath"
            },
            "max_pages": 2
        }
    },
    "meta": [
        {
            "object_name": "Книга",
            "object_selector": {
                "path": "//article[@class='product_pod']",
                "selector_type": "xpath"
            },
            "attributes": [
                {
                    "attribute_name": "Название",
                    "attribute_selector": {
                        "path": "./h3/a/@title",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Цена",
                    "attribute_selector": {
                        "path": ".//p[@class='price_color']/text()",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Наличие",
                    "attribute_selector": {
                        "path": ".//p[contains(@class, 'instock')]/text()",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Рейтинг",
                    "attribute_selector": {
                        "path": "./p[contains(@class, 'star-rating')]/@class",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "ссылка",
                    "attribute_selector": {
                        "path": "./h3/a/@href",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Cтраница книги",
                    "attribute_selector": {
                        "path": "./h3/a/@href",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "link",
                    "linked_attributes": [
                        {
                            "attribute_name": "Описание",
                            "attribute_selector": {
                                "path": "//meta[@name='description']/@content",
                                "selector_type": "xpath"
                            },
                            "attribute_type": "simple"
                        },
                        {
                            "attribute_name": "Категория",
                            "attribute_selector": {
                                "path": "//ul[@class='breadcrumb']/li[3]/a/text()",
                                "selector_type": "xpath"
                            },
                            "attribute_type": "simple"
                        }
                    ]
                },
                {
                    "attribute_name": "Cтраница книги 2",
                    "attribute_selector": {
                        "path": "./h3/a/@href",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "link",
                    "linked_attributes": [
                        {
                            "attribute_name": "Категория 2",
                            "attribute_selector": {
                                "path": "//ul[@class='breadcrumb']/li[3]/a/text()",
                                "selector_type": "xpath"
                            },
                            "attribute_type": "simple"
                        }
                    ]
                }
            ]
        }
    ]
}
