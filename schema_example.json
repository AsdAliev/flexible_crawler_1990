{
    "start_url": "https://www.findbook.ru/search/d1?title=%D1%E8%EC%E2%EE%EB%E8%F7%E5%F1%EA%E8%E5+%E4%E8%F0%E5%EA%F6%E8%E8&r=0&s=1&viewsize=15&startidx=",
    "crawler_settings": {
        "request_headers": {
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36",
            "Accept-Language": "en-US,en;q=0.9"
        },
        "request_delay": 2,
        "output_file_format": "csv",
        "pagination": {
            "enabled": true,
            "next_page_selector": {
                "path": "//a[@class='next']",
                "selector_type": "xpath"
            },
            "url_param_template": "startidx={page_number}",
            "start_page": 0,
            "max_pages": 10,
            "page_increment": 1
        }
    },
    "meta": [
        {
            "object_name": "book",
            "object_caption": "Книга",
            "object_selector": {
                "path": "//div[@class='results__book']",
                "selector_type": "xpath"
            },
            "attributes": [
                {
                    "attribute_name": "name",
                    "attribute_caption": "Наименование",
                    "attribute_selector": {
                        "path": "//b[@class='results__title-name']",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "author",
                    "attribute_caption": "Автор",
                    "attribute_selector": {
                        "path": "h4.results__title",
                        "selector_type": "css"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "offer",
                    "attribute_caption": "Предложение",
                    "attribute_selector": {
                        "path": "h4[class='results__title']",
                        "selector_type": "css"
                    },
                    "attribute_type": "array",
                    "delimiter": ";"
                }
            ]
        },
        {
            "object_name": "offer",
            "object_caption": "Предложение",
            "attributes": [
                {
                    "attribute_name": "price",
                    "attribute_caption": "Цена",
                    "attribute_selector": {
                        "path": "//span[@class='price']",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "link",
                    "attribute_caption": "Ссылка",
                    "attribute_selector": {
                        "path": "//a[@class='offer-link']",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                }
            ]
        }
    ]
}