{
    "start_url": "https://www.findbook.ru/search/d1?title=%D1%E8%EC%E2%EE%EB%E8%F7%E5%F1%EA%E8%E5+%E4%E8%F0%E5%EA%F6%E8%E8&r=0&s=1&viewsize=15&startidx=",
    "crawler_settings": {
        "allowed_domains": ["start_url", "other_sites"],
        "pagination": {
            "enabled": true,
            "next_page_selector": {
                "path": "//a[@class='next']",
                "selector_type": "xpath"
            },
            "url_param_template": "startidx={page_number}",
            "start_page": 0,
            "max_pages": 10,
            "page_increment": 1
        }
    },
    "meta": [
        {
            "object_name": "Книга",
            "object_selector": {
                "path": "//div[@class='results__book']",
                "selector_type": "xpath"
            },
            "attributes": [
                {
                    "attribute_name": "Наименование",
                    "attribute_selector": {
                        "path": "//b[@class='results__title-name']",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Автор",
                    "attribute_selector": {
                        "path": "h4.results__title",
                        "selector_type": "css"
                    },
                    "attribute_type": "simple"
                },
                {
                    "attribute_name": "Предложение",
                    "attribute_selector": {
                        "path": "h4[class='results__title']",
                        "selector_type": "css"
                    },
                    "attribute_type": "array",
                    "delimiter": ";"
                },
                {
                    "attribute_name": "Страница объекта",
                    "attribute_selector": {
                        "path": "//b[@class='results__title-name']",
                        "selector_type": "xpath"
                    },
                    "attribute_type": "link",
                    "linked_attributes": [
                        {
                            "attribute_name": "Описание",
                            "attribute_selector": {
                                "path": "//b[@class='results__title-name']",
                                "selector_type": "xpath"
                            },
                            "attribute_type": "simple"
                        }
                    ]
                }
            ]
        }
    ]
}