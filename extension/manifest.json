{
    "manifest_version": 3,
    "name": "DOM Crawler",
    "version": "0.1",
    "description": "Chose parsed elements and send parsing map to the server.",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/16_image.png",
            "48": "icons/48_image.png",
            "128": "icons/128_image.png"
        }
    },
    "devtools_page": "dev_tools/devtools.html",
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "run_at": "document_idle",
            "js": [
                "content_script.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}